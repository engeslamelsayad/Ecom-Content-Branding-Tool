# ---- Required ----
# Your Anthropic API key. Server-side only; it never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Database ----
# On Railway: add a Postgres service and reference its variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave unset locally to use SQLite.
DATABASE_URL=

# ---- First login (used once, on the very first boot) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-something-long
ADMIN_NAME=Owner

# ---- Storage ----
# MUST point at a mounted Railway Volume, or uploads vanish on every deploy.
STORAGE_DIR=/data/storage

# ---- Models (the hybrid routing) ----
MODEL_DEEP=claude-opus-5
MODEL_FAST=claude-sonnet-5
ENABLE_REFUSAL_FALLBACK=true

# ---- Limits ----
MAX_UPLOAD_MB=200
VIDEO_MAX_FRAMES=12
SESSION_DAYS=30

# ---- Optional final image/audio/video production ----
# Prefer entering your key in Studio > API connection as the owner.
# Server-only environment fallback when no encrypted key has been saved:
FAL_KEY=
OPENAI_API_KEY=
# KEY_ID:KEY_SECRET from the Higgsfield developer API account (separate billing).
HIGGSFIELD_KEY=
# Optional Fernet key. If unset, one is generated in STORAGE_DIR/.integration.key.
# Back up this key and the storage volume together with the database.
CONNECTION_ENCRYPTION_KEY=
PRODUCTION_DAILY_LIMIT=30
PRODUCTION_MAX_ACTIVE=2
PRODUCTION_POLL_SECONDS=5
MAX_CONCURRENT_RUNS=3
